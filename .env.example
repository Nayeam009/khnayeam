# Supabase connection, consumed by src/integrations/supabase/client.ts
#
# Copy this file to .env (git-ignored) and fill in the real values, and/or set the
# same variables under Vercel -> khnayeam -> Settings -> Environment Variables.
# If a variable is missing, client.ts falls back to the literals committed in that
# file, so the app still builds and runs without this file.
# Canonical project for this repo - the ONLY Supabase project it may use: quleuwbwldqhercdnjqc
VITE_SUPABASE_PROJECT_ID="quleuwbwldqhercdnjqc"
VITE_SUPABASE_URL="https://quleuwbwldqhercdnjqc.supabase.co"
# Leave empty to use the publishable ("anon") key committed in client.ts. An empty value is falsy,
# so the fallback applies; a wrong placeholder here would override it and break every request.
VITE_SUPABASE_PUBLISHABLE_KEY=""
